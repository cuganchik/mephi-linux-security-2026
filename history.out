    1  groupadd students
    2  getent group students
    3  useradd -m -u 1234 -g students user1
    4  id user1
    5  passwd user1
    6  chage -M 90 user1
    7  chage -l user1
    8  grep '^user1:' /etc/passwd
    9  grep '^user1:' /etc/shadow
   10  grep '^students:' /etc/group
   11  find / -type f -perm -4000 -ls 2>/dev/null
   12  find / -type f -perm -4000 -ls 2>/dev/null > ~/setuid.out
   13  cat ~/setuid.out
   14  ps -eo pid,ruid,euid,user,comm
   15  ps -eo pid,ruid,euid,user,comm | awk '$2 != 0 && $3 == 0'
   16  ps -eo pid,ruid,euid,user,comm | awk '$2 != 0 && $3 == 0' > ~/privileged-processes.out
   17  echo "MEPHI SECRET" > /root/mephi-secret.txt
   18  chmod 600 /root/mephi-secret.txt
   19  su - user1
   20  cp "$(which cat)" /home/user1/cat-suid
   21  chown root:students /home/user1/cat-suid
   22  chmod 4755 /home/user1/cat-suid
   23  stat /home/user1/cat-suid
   24  ls -l /home/user1/cat-suid
   25  su - user1
   26  which getcap
   27  echo "CAPABILITY SECRET" > /root/cap-secret.txt
   28  chmod 600 /root/cap-secret.txt
   29  cp "$(which cat)" /home/user1/cat-cap
   30  chown user1:students /home/user1/cat-cap
   31  setcap cap_dac_read_search+ep /home/user1/cat-cap
   32  getcap /home/user1/cat-cap
   33  su - user1
   34  which timedatectl
   35  visudo -f /etc/sudoers.d/user1-time
   36  visudo -c
   37  su - user1
   38  ls -l /bin/timedatectl /usr/bin/timedatectl
   39  su - user1
   40  visudo -f /etc/sudoers.d/user1-time
   41  su - user1
   42  echo 375708
   43  history > ~/history.out
